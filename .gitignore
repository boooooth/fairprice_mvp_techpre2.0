# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
prisma/*.db
prisma/*.db-journal

# binaries, tools & tunnels
*.exe
*.dll
*.so
*.dylib
cloudflared*
ngrok*

# media & screen recordings
*.mp4
*.mov
*.avi
*.webm
*.mkv

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDEs & editors
.idea/
.vscode/
*.swp
*.swo

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# temporary files
*.tmp
*.temp


