# ==============================================================================
# Database Configuration
# ==============================================================================
# SQLite database URL for Prisma. Relative to prisma/ directory.
DATABASE_URL="file:./dev.db"

# ==============================================================================
# Telegram Bot Configuration (Required for TMA & Bot features)
# ==============================================================================
# Telegram Bot Token obtained from @BotFather (e.g. 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# The public HTTPS URL where this application is accessible.
# Telegram Mini Apps REQUIRE valid HTTPS (e.g. via Cloudflare Tunnel, ngrok, or production domain).
TELEGRAM_WEBAPP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ==============================================================================
# Telegram Mini App Deep-Link Settings (for /qr page & physical signage)
# ==============================================================================
# Your bot username (without @) and the app short name configured in @BotFather (/newapp)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="FairPriceRewards_bot"
NEXT_PUBLIC_TELEGRAM_APP_NAME="myapp"

# ==============================================================================
# Bot Message & Button Customization (Optional)
# ==============================================================================
# Text for the button attached directly to the /start welcome message
TELEGRAM_START_BUTTON_TEXT="Open Member Pass"

# Text for the persistent menu button next to the chat input field
TELEGRAM_MENU_BUTTON_TEXT="Open Member Pass"

# Welcome message sent when a customer taps START in the bot.
# Supports {firstName}, {lastName}, {name}, \n for newlines, and basic HTML (<b>, <i>, <a>).
TELEGRAM_START_MESSAGE="<b>Welcome to FairPrice, {firstName}!</b>\n\nYour digital membership is ready. Tap the button below to access your member pass, earn reward points, and claim exclusive vouchers:"
